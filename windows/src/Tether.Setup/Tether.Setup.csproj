<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tether.Setup</AssemblyName>
    <RootNamespace>Tether.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tether.Shared\Tether.Shared.csproj" />
    <ProjectReference Include="..\Tether.Service\Tether.Service.csproj" />
  </ItemGroup>
  <!-- build.ps1 passes -p:PayloadDir=<folder holding the published service and helper exes> -->
  <ItemGroup Condition="'$(PayloadDir)' != ''">
    <EmbeddedResource Include="$(PayloadDir)\Tether.Service.exe" LogicalName="Tether.Service.exe" />
    <EmbeddedResource Include="$(PayloadDir)\Tether.Helper.exe" LogicalName="Tether.Helper.exe" />
  </ItemGroup>
</Project>
