# Seeds the first parent account when the users table is empty. Forces a password change at first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
PORT=3150
HOST=127.0.0.1
TETHER_DATA=/opt/tether/data

# SMTP2GO (alerts + login 2FA codes). ALERT_EMAIL_FROM must be a sender
# address verified in the SMTP2GO account, not just any address.
SMTP2GO_API_KEY=
ALERT_EMAIL_FROM=
